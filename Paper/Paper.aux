\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Distribución de las estaciones climáticas respecto a los estados federados de Alemania. Los polígonos delimitados por un contorno en color negro corresponden a los estados federados reportados por Bundesamt für Kartographie und Geodäsie \cite  {States_2025}. En color verde se muestran, de manera descendente, Brandemburgo, Sajonia y Baviera, respectivamente.}}{14}{figure.caption.20}\protected@file@percent }
\newlabel{Stations_per_state}{{5}{14}{Distribución de las estaciones climáticas respecto a los estados federados de Alemania. Los polígonos delimitados por un contorno en color negro corresponden a los estados federados reportados por Bundesamt für Kartographie und Geodäsie \cite {States_2025}. En color verde se muestran, de manera descendente, Brandemburgo, Sajonia y Baviera, respectivamente}{figure.caption.20}{}}
