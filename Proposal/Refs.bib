@article{STEHFEST_2007,
	title = {Simulation of global crop production with the ecosystem model DayCent},
	journal = {Ecological Modelling},
	volume = {209},
	number = {2},
	pages = {203-219},
	year = {2007},
	issn = {0304-3800},
	doi = {https://doi.org/10.1016/j.ecolmodel.2007.06.028},
	url = {https://www.sciencedirect.com/science/article/pii/S0304380007003365},
	author = {Stehfest, E. and Heistermann and Joerg A. Priess and Dennis S. Ojima and Joseph Alcamo},
	keywords = {Agriculture, Yield, Plant growth, Modelling, Global change},
	abstract = {Agriculture has become a key element within the earth system as it changes global biogeochemical and water cycles, while global environmental change affects land productivity and thus future land-use decisions. To address these issues and their complex interdependency in a consistent modelling approach we adapted the agro-ecosystem model DayCent for the simulation of major crops at the global scale. Based on a global compilation of environmental and management data and an algorithm to calculate global planting dates, DayCent was parameterised and calibrated to simulate global yield levels for wheat, maize, rice and soybeans. Simulation results show that the DayCent model is able to reproduce the major effects of climate, soil and management on crop production. Average simulated crop yield per country agree well with agricultural statistics (Modelling efficiency is about 0.66 for wheat, rice and maize, and 0.32 for soybean) and spatial patterns of yields generally correspond to observed crop distributions and sub-national census data.}
}

@article{BAHUGUNA_2015,
	title = {Temperature regulation of plant phenological development},
	journal = {Environmental and Experimental Botany},
	volume = {111},
	pages = {83-90},
	year = {2015},
	issn = {0098-8472},
	doi = {https://doi.org/10.1016/j.envexpbot.2014.10.007},
	url = {https://www.sciencedirect.com/science/article/pii/S0098847214002512},
	author = {Bahuguna, R.N. and  Jagadish, K.S.V.},
	keywords = {Cellular thermosensors, Thermal response, Plant developmental decisions, Plant signaling, Hormones, Metabolites},
	abstract = {Gradual and abrupt changes in temperature under current and future climates pose a serious threat to ecological diversity and in sustaining global food security. Plants possess a robust network of thermal sensors to program their metabolic and hormonal framework, providing acclimation to short-term abrupt fluctuations or adaptation to gradual temperature change. Several cellular thermosensors are reported in plants and understanding their mode of operation in a potentially coordinated framework continues to be a persistent challenge. Despite growing insight into the molecular control of thermal perception, physiological significance of plant thermal responses under a complex interaction with other environmental cues is largely unaddressed. Plant thermal perception and signaling could be similar across growth habits such as herbaceous to perennial woody species while developmental transitions such as vegetative to reproductive stage, influenced by their immediate microclimate, are generally altered across growth habits. The overall aim is to connect the knowledge gained with thermal perception and the signaling that drives plant responses, with major focus on the latter.}
}

